apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.AppName}}
  labels:
    app: {{.AppName}}
    managed-by: golden-path-cli
spec:
  replicas: 2
  selector:
    matchLabels:
      app: {{.AppName}}
  template:
    metadata:
      labels:
        app: {{.AppName}}
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        fsGroup: 65532
      containers:
        - name: {{.AppName}}
          image: {{.AppName}}:latest
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: {{.Port}}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              cpu: "100m"
              memory: "128Mi"
            limits:
              cpu: "500m"
              memory: "256Mi"
